name: Run Chrome Remote Desktop

on:
  workflow_dispatch:
    inputs:
      crd_code:
        description: 'Enter your Chrome Remote Desktop CODE'
        required: true
        type: string
      pin_number:
        description: 'Enter PIN (6 digits)'
        required: true
        default: '123456'
        type: string

jobs:
  deploy-crd:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Run Chrome Remote Desktop Container
        run: |
          docker run -d \
            --name chrome-remote-desktop \
            --restart unless-stopped \
            -e HOSTNAME=my-desktop \
            -e CODE='${{ github.event.inputs.crd_code }}' \
            -e PIN='${{ github.event.inputs.pin_number }}' \
            cardinalby/chrome-remote-desktop:master
            
          echo "Chrome Remote Desktop started successfully with input code!"
